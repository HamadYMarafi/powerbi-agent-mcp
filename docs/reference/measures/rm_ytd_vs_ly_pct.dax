VAR __a =
VAR _Cut = CALCULATE(MAX('Date'[Date]), 'Date'[HasSales] = TRUE)
VAR _Y = CALCULATE(MAX('Date'[TradingYear]), ALL('Date'), 'Date'[Date] = _Cut)
VAR _W = CALCULATE(MAX('Date'[TradingWeek]), ALL('Date'), 'Date'[Date] = _Cut)
VAR _Dn = CALCULATETABLE(VALUES('Date'[DayName]), ALL('Date'), 'Date'[Date] = _Cut)
VAR _DnW = CALCULATETABLE(VALUES('Date'[DayName]), ALL('Date'), 'Date'[TradingYear] = _Y, 'Date'[TradingWeek] = _W, 'Date'[HasSales] = TRUE, 'Date'[Date] <= _Cut)
RETURN CALCULATE([Sales], REMOVEFILTERS('Date'), 'Date'[TradingYear] = _Y, 'Date'[Date] <= _Cut)
VAR __b =
VAR _Cut = CALCULATE(MAX('Date'[Date]), 'Date'[HasSales] = TRUE)
VAR _Y = CALCULATE(MAX('Date'[TradingYear]), ALL('Date'), 'Date'[Date] = _Cut)
VAR _W = CALCULATE(MAX('Date'[TradingWeek]), ALL('Date'), 'Date'[Date] = _Cut)
VAR _Dn = CALCULATETABLE(VALUES('Date'[DayName]), ALL('Date'), 'Date'[Date] = _Cut)
VAR _DnW = CALCULATETABLE(VALUES('Date'[DayName]), ALL('Date'), 'Date'[TradingYear] = _Y, 'Date'[TradingWeek] = _W, 'Date'[HasSales] = TRUE, 'Date'[Date] <= _Cut)
RETURN CALCULATE([Sales], REMOVEFILTERS('Date'), 'Date'[TradingYear] = _Y - 1, FILTER(ALL('Date'[TradingWeek], 'Date'[DayName]), 'Date'[TradingWeek] < _W || ('Date'[TradingWeek] = _W && 'Date'[DayName] IN _DnW)))
RETURN DIVIDE(__a - __b, __b)
